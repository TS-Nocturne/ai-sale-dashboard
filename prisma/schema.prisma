// Prisma Schema for AI Native App
// Better Auth + PostgreSQL (Neon)

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ==========================================
// Better Auth Core Schema
// ==========================================

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  role          String    @default("user") // "user" | "employee" | "manager" | "admin"
  banned        Boolean?
  banReason     String?
  banExpires    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  sessions Session[]
  accounts Account[]

  @@map("user")
}

model Session {
  id              String   @id @default(cuid())
  userId          String
  token           String   @unique
  expiresAt       DateTime
  ipAddress       String?
  userAgent       String?
  impersonatedBy  String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("session")
}

model Account {
  id                    String    @id @default(cuid())
  userId                String
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  idToken               String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("account")
}

model Verification {
  id         String    @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime? @default(now())
  updatedAt  DateTime? @updatedAt

  @@map("verification")
}

// ==========================================
// Sales Domain Schema
// ==========================================

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  PROPOSAL
  NEGOTIATION
  WON
  LOST

  @@map("lead_status")
}

enum LeadSource {
  FACEBOOK
  LINE
  INSTAGRAM
  TIKTOK
  REFERRAL
  WEBSITE
  COLD_CALL
  OTHER

  @@map("lead_source")
}

enum SaleStatus {
  PENDING
  CONFIRMED
  DELIVERED
  CANCELLED
  REFUNDED

  @@map("sale_status")
}

model Product {
  id          String   @id @default(cuid())
  // SKU is the "Unique Identifier" used by the inventory sync to decide whether
  // a row from an uploaded file is an existing product (update) or a new one
  // (insert). Nullable so manually-created products without a SKU still work;
  // PostgreSQL treats multiple NULLs as distinct, so @unique stays valid.
  sku         String?  @unique
  name        String
  description String?
  category    String?
  price       Float
  stock       Int      @default(0)
  unit        String   @default("ชิ้น")
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  saleItems SaleItem[]

  @@index([category])
  @@map("product")
}

model Customer {
  id          String   @id @default(cuid())
  name        String
  phone       String?
  email       String?
  lineId      String?
  // LINE Messaging API user id — used to link chat orders + store credit wallet.
  lineUserId  String?  @unique
  address     String?
  note        String?
  storeCredit Float    @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  leads  Lead[]
  sales  Sale[]
  orders Order[]

  @@map("customer")
}

model Lead {
  id         String     @id @default(cuid())
  name       String
  phone      String?
  email      String?
  lineId     String?
  source     LeadSource @default(OTHER)
  status     LeadStatus @default(NEW)
  budget     Float?
  note       String?
  customerId String?
  assignedTo String?
  closedAt   DateTime?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  customer Customer? @relation(fields: [customerId], references: [id])
  sale     Sale?

  @@map("lead")
}

model Sale {
  id          String     @id @default(cuid())
  leadId      String?    @unique
  customerId  String?
  status      SaleStatus @default(PENDING)
  totalAmount Float
  discount    Float      @default(0)
  netAmount   Float
  note        String?
  soldBy      String?
  soldAt      DateTime   @default(now())
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  lead      Lead?      @relation(fields: [leadId], references: [id])
  customer  Customer?  @relation(fields: [customerId], references: [id])
  saleItems SaleItem[]

  @@map("sale")
}

model SaleItem {
  id        String  @id @default(cuid())
  saleId    String
  productId String
  qty       Int     @default(1)
  unitPrice Float
  total     Float

  sale    Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@map("sale_item")
}

// ==========================================
// AI Assistant / Conversation Schema
// ==========================================
// Next.js owns persistence of the chat history (SQL), while the Python
// "brain" (FastAPI + LangGraph) keeps its own working memory keyed by the
// Conversation.id (used as the LangGraph thread_id).

enum MessageRole {
  USER
  ASSISTANT
  SYSTEM

  @@map("message_role")
}

model Conversation {
  id            String   @id @default(cuid())
  title         String?
  userId        String? // owner (dashboard user) — nullable for external channels
  customerId    String? // optional link to a CRM customer
  leadScore     Int      @default(0)
  pipelineStage String   @default("new")
  // True when the conversation is paused awaiting manager discount approval.
  awaitingApproval Boolean @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  messages Message[]

  @@index([userId])
  @@index([customerId])
  @@map("conversation")
}

model Message {
  id             String      @id @default(cuid())
  conversationId String
  role           MessageRole
  content        String
  // Public URL of an image the customer sent (e.g. a transfer slip or product
  // photo) so staff can see it in the Live Chat dashboard. Null for text-only
  // messages.
  imageUrl       String?
  // Optional structured metadata from the brain (lead score, pending discount, etc.)
  metadata       Json?
  createdAt      DateTime    @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@map("message")
}

// ==========================================
// AI Handoff & Approval Schema
// ==========================================
// `ChatThread.id` mirrors the LangGraph thread_id (== Conversation.id). The
// Python brain flips botStatus to PAUSED_FOR_HUMAN on escalation; staff flip it
// back to ACTIVE from the Live Chat dashboard.

enum BotStatus {
  ACTIVE
  PAUSED_FOR_HUMAN

  @@map("bot_status")
}

enum ApprovalAction {
  PENDING
  APPROVED
  REJECTED

  @@map("approval_action")
}

model ChatThread {
  id            String    @id // == Conversation.id / LangGraph thread_id
  botStatus     BotStatus @default(ACTIVE)
  handoffReason String?
  pausedAt      DateTime?
  resumedAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  approvalRequests ApprovalRequest[]

  @@index([botStatus])
  @@map("chat_thread")
}

model ApprovalRequest {
  id            String         @id @default(cuid())
  threadId      String
  product       String
  discountPct   Float
  originalPrice Float?
  reason        String?
  status        ApprovalAction @default(PENDING)
  decidedBy     String? // manager userId who approved/rejected
  decidedAt     DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  thread ChatThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@index([threadId])
  @@index([status])
  @@map("approval_request")
}

// ==========================================
// Orders / Fulfillment Schema
// ==========================================
// When a customer has paid (verified transfer slip) or chosen COD, the AI
// collects shipping details (name / phone / address / postal code) via
// structured output and the Next.js side materialises an Order row for staff
// to pack and ship.

enum PaymentMethod {
  TRANSFER
  COD

  @@map("payment_method")
}

enum PaymentStatus {
  PENDING
  PARTIAL_PAID
  PAID
  PENDING_REFUND
  CANCELLED

  @@map("payment_status")
}

enum OverpayResolution {
  KEPT_AS_CREDIT
  PENDING_REFUND
  REFUNDED

  @@map("overpay_resolution")
}

enum OrderStatus {
  COLLECTING // ยังเก็บข้อมูลจัดส่งไม่ครบ
  PENDING_FULFILLMENT // ข้อมูลครบ รอแพ็คของ
  SHIPPED // ส่งของแล้ว
  CANCELLED

  @@map("order_status")
}

model Order {
  id            String        @id @default(cuid())
  threadId      String // == Conversation.id / LangGraph thread_id
  customerId    String?
  customerName  String
  phone         String
  address       String
  postalCode    String?
  paymentMethod PaymentMethod @default(TRANSFER)
  items         String? // สรุปรายการสินค้า (free text)
  // Payment tracking
  totalAmount   Float? // ยอดที่ต้องชำระทั้งหมด
  paidAmount    Float         @default(0) // ยอดที่โอนมาแล้ว (รวมทุกสลิป)
  paymentStatus PaymentStatus @default(PENDING)
  overpaidAmount Float        @default(0)
  overpayResolution OverpayResolution?
  // Legacy alias — kept in sync with totalAmount for older code paths
  amount        Float?
  // Legacy single-slip fields (first slip); see PaymentSlip for all slips
  slipVerified    Boolean @default(false)
  slipReferenceId String?
  slipImageUrl    String?
  // Fulfillment
  status         OrderStatus @default(PENDING_FULFILLMENT)
  trackingNumber String?
  note           String?
  shippedBy      String?
  shippedAt      DateTime?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  customer Customer?    @relation(fields: [customerId], references: [id])
  slips    PaymentSlip[]

  @@index([threadId])
  @@index([status])
  @@index([paymentStatus])
  @@map("order")
}

model PaymentSlip {
  id          String   @id @default(cuid())
  orderId     String
  amount      Float
  imageUrl    String?
  referenceId String?  @unique
  isVerified  Boolean  @default(true)
  createdAt   DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("payment_slip")
}

// ==========================================
// Knowledge Base (Unstructured Data → Vector DB)
// ==========================================
// Knowledge files (PDF / FAQ / policies) are UNSTRUCTURED data. Next.js stores
// the document record here for management (list / search / delete), while the
// Python brain (FastAPI) chunks + embeds the content into Pinecone for RAG.
// This is deliberately separate from the Product table, which holds STRUCTURED
// inventory data.

enum KnowledgeStatus {
  PENDING // created, not yet embedded into the vector DB
  INDEXED // chunked + embedded into Pinecone, usable for RAG
  FAILED // indexing failed (see error in metadata/logs)

  @@map("knowledge_status")
}

model KnowledgeDocument {
  id        String          @id @default(cuid())
  title     String
  content   String // extracted plain text (kept for re-index + preview)
  source    String? // original filename, if uploaded
  fileType  String? // "pdf" | "csv" | "txt" | "manual"
  fileSize  Int? // bytes
  status    KnowledgeStatus @default(PENDING)
  chunkCount Int            @default(0) // number of vectors stored in Pinecone
  createdBy String // userId of the uploader
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@index([status])
  @@map("knowledge_document")
}
